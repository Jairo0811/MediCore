{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=MediCore;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Auth": {
    "AllowBootstrapAdmin": true
  },
  "Database": {
    "InitializeOnStartup": false
  },
  "Jwt": {
    "Issuer": "MediCore",
    "Audience": "MediCore.Web",
    "SigningKey": "MediCore-Development-Key-Change-Before-Production-2026",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "CedulaValidation": {
    "LuhnExceptionHashes": []
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
